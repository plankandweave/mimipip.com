    "start:vinext": "node scripts/brand-setup-required.mjs",
    "deploy:vinext": "node scripts/brand-setup-required.mjs",
    "review:local": "node scripts/local-review.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck:app": "tsc --noEmit --project tsconfig.app.json",
