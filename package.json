    "@vinext/cloudflare": "1.0.0-beta.7",
    "@xenova/transformers": "^2.17.2",
    "exceljs": "^4.4.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "sharp": "^0.35.5",
