{
  "name": "mimi-pip-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "MIMIPIP_LOCAL_REVIEW=1 NEXT_PUBLIC_MIMIPIP_LOCAL_REVIEW=1 NEXT_TELEMETRY_DISABLED=1 vinext build",
    "start": "node scripts/brand-setup-required.mjs",
