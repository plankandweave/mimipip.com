  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "0.28.2",
