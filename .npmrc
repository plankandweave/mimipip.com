# sharp's linux binaries (@img/sharp-linux-x64 and the @img/sharp-libvips-linux-x64
# shared library it dlopens) declare `libc: ["glibc"]`. When npm cannot determine
# the target libc it SILENTLY SKIPS them — they are optionalDependencies — and
# sharp falls back to @img/sharp-wasm32, leaving no libvips-cpp.so in the build.
# Every sharp route then dies at runtime with
#   ERR_DLOPEN_FAILED: libvips-cpp.so.8.18.3: cannot open shared object file
# which is exactly what happened on Vercel (live 500s, 19 Aug 2026). Stating the
# libc here makes the install deterministic on any builder. Harmless locally:
# the darwin binaries carry no libc constraint, so they still install.
libc=glibc

# Lay node_modules out FLAT, the way npm does.
#
# pnpm's default is a symlink farm: every package is a link into .pnpm/. Vercel's
# serverless packager walks that tree and copies it, and on a package that is
# itself a link where it expects a directory it stops dead —
#   ENOTDIR: not a directory, mkdir
#     /tmp/lambda-.../.pnpm/@xenova+transformers@2.17.2/node_modules/onnxruntime-node
# which is what killed the deploy step even once the build itself passed.
#
# Hoisting costs disk and loses pnpm's strictness about undeclared imports. It
# buys a node_modules the bundler can actually copy, which is the difference
# between deploying and not.
node-linker=hoisted
